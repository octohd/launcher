<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OctoHD.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <FontFamily x:Key="OctoDisplayFont">avares://OctoHD/Assets/Fonts#Cinzel Decorative</FontFamily>
    <SolidColorBrush x:Key="OctoBackground">#0D1117</SolidColorBrush>
    <SolidColorBrush x:Key="OctoSurface">#DC161C24</SolidColorBrush>
    <SolidColorBrush x:Key="OctoSurfaceRaised">#F01B242E</SolidColorBrush>
    <SolidColorBrush x:Key="OctoGold">#E3A13A</SolidColorBrush>
    <SolidColorBrush x:Key="OctoGoldBright">#FFC55E</SolidColorBrush>
    <SolidColorBrush x:Key="OctoBlue">#3695BE</SolidColorBrush>
    <SolidColorBrush x:Key="OctoText">#D5DEE4</SolidColorBrush>
    <SolidColorBrush x:Key="OctoHeading">#F0D39F</SolidColorBrush>
    <SolidColorBrush x:Key="OctoHeadingBright">#FFE0A0</SolidColorBrush>
    <SolidColorBrush x:Key="OctoMuted">#8E9BA7</SolidColorBrush>
    <SolidColorBrush x:Key="OctoBorder">#2D3944</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOn">#C87C21</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#DE912E</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed">#A8661C</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled">#72512E</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn">#FFC55E</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver">#FFE0A0</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed">#E3A13A</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled">#80623C</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn">#FFF8EC</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed">#FFE9BE</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled">#B9A98E</SolidColorBrush>

    <!-- OctoHD ComboBox palette -->
    <SolidColorBrush x:Key="ComboBoxBackground">#F0161D25</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver">#F0202932</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed">#F02B251D</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled">#99161D25</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused">#F0161D25</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused">#2D3944</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused">#FFC55E</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxForeground">#D5DEE4</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxForegroundFocused">#FFF0D2</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed">#FFF8EC</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled">#667581</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrush">#354450</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#A66B2B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed">#E3A13A</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled">#26313A</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground">#D39A43</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused">#FFC55E</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed">#FFF0D2</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled">#667581</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground">#FB12181F</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#8C6531</SolidColorBrush>
    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">3</Thickness>
    <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
    <SolidColorBrush x:Key="ComboBoxItemForeground">#D5DEE4</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver">#FFF0D2</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed">#FFF8EC</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected">#FFE0A0</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver">#FFF0D2</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed">#FFF8EC</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled">#667581</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled">#806F56</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackground">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver">#E528333C</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed">#F03A2B1B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected">#E63A2B1B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver">#F04A341C</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed">#F05B3B1A</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled">#663A2B1B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver">#4B5B67</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed">#A66B2B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected">#E3A13A</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver">#FFC55E</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed">#FFC55E</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled">#72512E</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Foreground" Value="{StaticResource OctoText}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#273440" />
      <Setter Property="Foreground" Value="{StaticResource OctoText}" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#344656" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoGold}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#C87C21" />
      <Setter Property="Foreground" Value="#FFF8EC" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoGoldBright}" />
      <Setter Property="FontFamily" Value="{StaticResource OctoDisplayFont}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#DE912E" />
    </Style>

    <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DE912E" />
      <Setter Property="BorderBrush" Value="#E3A13A" />
      <Setter Property="Foreground" Value="#FFF8EC" />
    </Style>

    <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#824513" />
      <Setter Property="BorderBrush" Value="#E3A13A" />
      <Setter Property="Foreground" Value="#FFF8EC" />
    </Style>

    <Style Selector="Button.save:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DE912E" />
      <Setter Property="BorderBrush" Value="#E3A13A" />
      <Setter Property="Foreground" Value="#FFF8EC" />
    </Style>

    <Style Selector="Button.save:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#824513" />
      <Setter Property="BorderBrush" Value="#E3A13A" />
      <Setter Property="Foreground" Value="#FFF8EC" />
    </Style>

    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#67302E" />
      <Setter Property="BorderBrush" Value="#B85C4F" />
    </Style>

    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="#F011161D" />
      <Setter Property="BorderBrush" Value="#26313A" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="18,24,18,20" />
    </Style>

    <Style Selector="Border.navItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="0,11" />
      <Setter Property="MinHeight" Value="42" />
    </Style>

    <Style Selector="Border.navItem.active">
      <Setter Property="Background" Value="#B0242B33" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#9A202832" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.sourcePanel">
      <Setter Property="Background" Value="#B8151C23" />
      <Setter Property="BorderBrush" Value="#28343E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="13" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #55000000" />
    </Style>

    <Style Selector="Border.contextPanel">
      <Setter Property="Background" Value="#DB151B22" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="18,15" />
      <Setter Property="BoxShadow" Value="0 8 26 0 #52000000" />
    </Style>

    <Style Selector="Border.statusPanel">
      <Setter Property="Background" Value="#CE13212A" />
      <Setter Property="BorderBrush" Value="#25404E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BoxShadow" Value="0 5 18 0 #42000000" />
    </Style>

    <Style Selector="Border.updatePanel">
      <Setter Property="Background" Value="#E32B2115" />
      <Setter Property="BorderBrush" Value="#8F6024" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BoxShadow" Value="0 5 18 0 #42000000" />
    </Style>

    <Style Selector="Border.patchCard">
      <Setter Property="Background" Value="{StaticResource OctoSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 8 22 0 #5C000000" />
    </Style>

    <Style Selector="Border.patchCard:pointerover">
      <Setter Property="BorderBrush" Value="#7B6439" />
      <Setter Property="Background" Value="{StaticResource OctoSurfaceRaised}" />
    </Style>

    <Style Selector="Border.patchCard.enabled">
      <Setter Property="BorderBrush" Value="#D98A2B" />
    </Style>

    <Style Selector="Border.patchCard.enabled:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource OctoGoldBright}" />
    </Style>

    <Style Selector="Border.statusBadge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="#E5161D25" />
      <Setter Property="Foreground" Value="{StaticResource OctoText}" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CaretBrush" Value="{StaticResource OctoGoldBright}" />
      <Setter Property="SelectionBrush" Value="#9A704318" />
      <Setter Property="SelectionForegroundBrush" Value="#FFF8EC" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#F01A222B" />
      <Setter Property="BorderBrush" Value="#8C6531" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#F01D252E" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoGold}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 1 #55E3A13A" />
    </Style>

    <Style Selector="ComboBox.octoSelect">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="11,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>

    <Style Selector="ComboBox.octoSelect.sourceSelect">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="10" />
    </Style>

    <Style Selector="ComboBox.octoSelect:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="#F0202932" />
      <Setter Property="BorderBrush" Value="#A66B2B" />
    </Style>

    <Style Selector="ComboBox.octoSelect:dropdownopen /template/ Border#Background">
      <Setter Property="Background" Value="#F02B251D" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoGold}" />
    </Style>

    <Style Selector="ComboBox.octoSelect:focus-visible /template/ Border#HighlightBackground">
      <Setter Property="Background" Value="#442E2114" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoGoldBright}" />
    </Style>

    <Style Selector="ComboBox.octoSelect /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="#D39A43" />
    </Style>

    <Style Selector="ComboBox.octoSelect:pointerover /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource OctoGoldBright}" />
    </Style>

    <Style Selector="ComboBox.octoSelect:dropdownopen /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource OctoHeadingBright}" />
    </Style>

    <Style Selector="ComboBox.octoSelect:dropdownopen /template/ Border#PopupBorder">
      <Setter Property="Background" Value="#FB12181F" />
      <Setter Property="BorderBrush" Value="#8C6531" />
      <Setter Property="BoxShadow" Value="0 12 30 0 #A0000000" />
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>

    <Style Selector="TextBox.sourceField">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="9,0" />
    </Style>

    <Style Selector="ToggleSwitch">
      <Setter Property="Foreground" Value="{StaticResource OctoMuted}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleSwitch /template/ Border#OuterBorder">
      <Setter Property="Background" Value="#27323B" />
      <Setter Property="BorderBrush" Value="#65727D" />
    </Style>

    <Style Selector="ToggleSwitch:pointerover /template/ Border#OuterBorder">
      <Setter Property="Background" Value="#34434E" />
      <Setter Property="BorderBrush" Value="#8E9BA7" />
    </Style>

    <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Fill" Value="#C5D0D7" />
    </Style>

    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{StaticResource OctoGold}" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoGoldBright}" />
    </Style>

    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="#DE912E" />
      <Setter Property="BorderBrush" Value="{StaticResource OctoHeadingBright}" />
    </Style>

    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="#FFF8EC" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource OctoMuted}" />
    </Style>

    <Style Selector="TextBlock.displayTitle">
      <Setter Property="FontFamily" Value="{StaticResource OctoDisplayFont}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource OctoHeadingBright}" />
      <Setter Property="LetterSpacing" Value="0.3" />
    </Style>

    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontFamily" Value="{StaticResource OctoDisplayFont}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource OctoHeading}" />
      <Setter Property="LetterSpacing" Value="0.15" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource OctoBlue}" />
      <Setter Property="Background" Value="#25313A" />
      <Setter Property="Height" Value="5" />
    </Style>
  </Application.Styles>
</Application>
